PORT=4000
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria
NODE_ENV=production

# Connection string do banco Postgres (ex: a fornecida pelo Supabase,
# em Project Settings -> Database -> Connection string, formato URI)
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco

# Alternativa: variáveis separadas, usadas só se DATABASE_URL não estiver definida
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
