{
  "name": "upfront-crm",
  "version": "1.0.0",
  "private": true,
  "description": "CRM e gestão de leads da Upfront School (English school online).",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "seed": "npm run seed --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm run build --workspace client && node server/src/index.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
